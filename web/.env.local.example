## 本地开发环境变量示例（不要提交包含真实 key 的 .env.local）
##
## 用法：
## 1) 复制本文件为 .env.local
## 2) 填入 Supabase 项目对应的值
##
## Supabase（必需：用于读取/写入 fixtures、predictions、odds、explanations 等表）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

## 生产环境必需：保护系统、总控、聊天和写接口。请使用独立强密码。
WORKBENCH_ADMIN_USER=
WORKBENCH_ADMIN_PASSWORD=

## 可选：用于“单场助手解读”（OpenRouter）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

## 可选：用于 BYOK（用户自带 Key）的加密密钥（服务端使用）
## 生成方式（PowerShell）：
## node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

## 可选：逗号分隔的额外可信 LLM 主机。内置支持方舟、DeepSeek 和百炼。
LLM_ALLOWED_HOSTS=

## 仅供本地过渡调试。Vercel/生产环境不要开启。
ALLOW_LOCAL_ARTIFACTS=false

## 可选：用于导入赛程（football-data.org）
FOOTBALL_DATA_API_KEY=

## 可选：其他数据源
API_FOOTBALL_KEY=
